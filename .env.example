# ============================================================
# 大模型配置（OpenAI 兼容接口）
# 默认预设：通义千问（DashScope）
#   视觉模型 qwen-vl-max —— 识别手写作文
#   文本模型 qwen-plus   —— 按评分标准打分
# ============================================================

# 通义千问 DashScope API Key（https://dashscope.aliyuncs.com 申请）
# 视觉与评分共用一个 Key 时，只填这一个即可。
# 也可用 ZHIPU_API_KEY / OPENAI_API_KEY 作为通用 Key。
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxx

# 视觉模型（识别手写作文）
# AI_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_VISION_MODEL=qwen-vl-max
# AI_VISION_API_KEY=        # 若与评分 Key 不同才需要单独填写

# 文本模型（评分）
# AI_GRADING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AI_GRADING_MODEL=qwen-plus
# AI_GRADING_API_KEY=       # 若与视觉 Key 不同才需要单独填写

# ---- 其他 OpenAI 兼容服务示例（取消注释并修改即可）----
# 智谱 GLM（视觉识别免费）:
# AI_VISION_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_VISION_MODEL=glm-4v-flash
# AI_GRADING_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# AI_GRADING_MODEL=glm-4-flash
#
# OpenAI:
# AI_VISION_BASE_URL=https://api.openai.com/v1
# AI_VISION_MODEL=gpt-4o-mini
# AI_GRADING_BASE_URL=https://api.openai.com/v1
# AI_GRADING_MODEL=gpt-4o-mini
#
# 本地 Ollama:
# AI_VISION_BASE_URL=http://127.0.0.1:11434/v1
# AI_VISION_MODEL=qwen2.5-vl
# AI_GRADING_BASE_URL=http://127.0.0.1:11434/v1
# AI_GRADING_MODEL=qwen2.5
